<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Attribura does NOT "track" in Apple's sense: it never links your users' data
	     with third-party data for targeted advertising, and shares nothing with data
	     brokers. So this SDK's data collection triggers no ATT prompt. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!-- The app-provided user id, transmitted so a later purchase can inherit the
		     self-reported channel. Linked to the user; used for analytics only. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<!-- Which onboarding steps a run reached, so the dashboard can draw the
		     drop-off funnel. Step NAMES only — the ones the app itself declared.
		     Linked to the user, analytics only, never used for tracking. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<!-- The transactions Apple signed, forwarded verbatim so the server can
		     verify them against Apple's root and credit the post that earned the
		     sale. Product id, price and Apple's transaction id — linked to the
		     user, analytics only, and never shared with anyone. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePurchaseHistory</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<!-- The "How did you hear about us?" answer (a marketing-channel label). -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherDataTypes</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
	</array>
	<!-- No "required reason" APIs: the retry queue is plain file I/O in the caches
	     directory, the install id is plain file I/O in Application Support
	     (deliberately NOT UserDefaults, which is one, and deliberately not the
	     Keychain, which would outlive the app), and the onboarding run id is held
	     in memory for the life of the process — no file-timestamp, UserDefaults,
	     disk-space, or boot-time APIs. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
</dict>
</plist>
